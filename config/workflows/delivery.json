{
  "name": "delivery",
  "description": "default workflow, contains product, ui, developer, tester nodes",
  "workflow_permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Bash(rm *)"
    ],
    "ask": [],
    "allow": []
  },
  "max_rework_cycles": 99,
  "nodes": [
    {
      "id": "product",
      "role": "product",
      "provider": "default",
      "permissions": {
        "allow": [
          "Read",
          "LS",
          "Glob",
          "Grep",
          "ArtifactWrite",
            "ArtifactRead",
          "AttachImage"
        ]
      }
    },
    {
      "id": "ui",
      "role": "ui",
      "provider": "default",
      "permissions": {
        "allow": [
          "Read",
          "LS",
          "Glob",
          "Grep",
          "ArtifactWrite",
            "ArtifactRead",
          "AttachImage"
        ]
      }
    },
    {
      "id": "developer",
      "role": "developer",
      "provider": "default",
      "permissions": {
        "allow": [
          "Read",
          "Write",
          "Edit",
          "MultiEdit",
          "LS",
          "Glob",
          "Grep",
          "ProcessStart",
          "ProcessStatus",
          "ProcessStop",
          "ArtifactWrite",
            "ArtifactRead",
          "AttachImage"
        ]
      }
    },
    {
      "id": "tester",
      "role": "tester",
      "provider": "default",
      "mode": "complete",
      "permissions": {
        "allow": [
          "Read",
          "LS",
          "Glob",
          "Grep",
          "ProcessStart",
          "ProcessStatus",
          "ProcessStop",
          "ArtifactWrite",
            "ArtifactRead"
        ]
      }
    }
  ]
}
